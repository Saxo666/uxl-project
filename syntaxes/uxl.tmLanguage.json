{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "UXL",
  "scopeName": "source.uxl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#events"
    },
    {
      "include": "#string"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.uxl",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.uxl",
          "match": "\\b(state|text|input|button|if|elif|else|for|in|range)\\b"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "entity.name.function.event.uxl",
          "match": "\\bonClick\\b(?=\\s*=>)"
        },
        {
          "name": "keyword.operator.arrow.uxl",
          "match": "=>"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.uxl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "name": "constant.character.escape.uxl",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.uxl",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "variable.other.interpolated.uxl",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#booleans"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.uxl",
          "match": "\\b\\d*\\.\\d+\\b|\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.uxl",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.uxl",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.uxl",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.uxl",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.uxl",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "punctuation.separator.colon.uxl",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.uxl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
