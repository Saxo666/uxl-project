{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "(",
      "close": ")"
    }
  ],
  "surroundingPairs": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "(",
      "close": ")"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|elif|else|button|for)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
