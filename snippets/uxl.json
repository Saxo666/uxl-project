{
  "State Variable": {
    "prefix": "state",
    "body": [
      "state ${1:name} = ${2:0}"
    ],
    "description": "Declare a UXL state variable"
  },
  "Text": {
    "prefix": "text",
    "body": [
      "text \"${1:Hello {name}}\""
    ],
    "description": "Render text in UXL"
  },
  "Input": {
    "prefix": "input",
    "body": [
      "input ${1:name}"
    ],
    "description": "Render an input bound to a state variable"
  },
  "Button": {
    "prefix": "button",
    "body": [
      "button \"${1:Click me}\":",
      "    onClick => ${2:count} = ${2:count} + ${3:1}"
    ],
    "description": "Create a button with an onClick handler"
  },
  "If Elif Else": {
    "prefix": "if",
    "body": [
      "if ${1:count} >= ${2:10}:",
      "    ${3:text \"High\"}",
      "elif ${1:count} >= ${4:5}:",
      "    ${5:text \"Medium\"}",
      "else:",
      "    ${6:text \"Low\"}"
    ],
    "description": "Create an if / elif / else block"
  },
  "For Range": {
    "prefix": "for",
    "body": [
      "for ${1:i} in range(${2:1}, ${3:6}):",
      "    ${4:text \"Item {i}\"}"
    ],
    "description": "Loop with Python-style range()"
  },
  "Assignment": {
    "prefix": "assign",
    "body": [
      "${1:total} = (${2:price} * ${3:qty}) - ${4:discount}"
    ],
    "description": "Assign the result of an expression"
  }
}
